ARG ANPR_BASE_IMAGE=eolo-anpr-api:latest
ARG GO2RTC_VERSION=v1.9.14

FROM node:22-bookworm-slim AS node-runtime

FROM ${ANPR_BASE_IMAGE}
ARG GO2RTC_VERSION

ENV NODE_ENV=production \
    PORT=8080 \
    ANPR_API_PORT=8090

COPY --from=node-runtime /usr/local /usr/local

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

COPY src ./src
COPY public ./public
COPY .env.example ./.env.example
COPY AnprEolo ./AnprEolo
COPY docker/all-in-one-entrypoint.sh /usr/local/bin/eolo-all-in-one-entrypoint
ADD https://github.com/AlexxIT/go2rtc/releases/download/${GO2RTC_VERSION}/go2rtc_linux_amd64 /usr/local/bin/go2rtc

RUN chmod +x /usr/local/bin/eolo-all-in-one-entrypoint \
    && chmod +x /usr/local/bin/go2rtc \
    && chmod +x /app/AnprEolo/stream/rtsptomse \
    && mkdir -p /app/data /app/uploads /app/data/anpr /app/AnprEolo/static/captures

EXPOSE 8080 8083 1984 8555/tcp 8555/udp

HEALTHCHECK --interval=30s --timeout=8s --start-period=60s --retries=3 CMD node -e "Promise.all([fetch('http://127.0.0.1:' + (process.env.PORT || 8080) + '/api/health'), fetch('http://127.0.0.1:' + (process.env.ANPR_API_PORT || 8090) + '/api/health')]).then(([bridge, anpr]) => process.exit(bridge.ok && anpr.ok ? 0 : 1)).catch(() => process.exit(1))"

ENTRYPOINT ["/bin/sh", "/usr/local/bin/eolo-all-in-one-entrypoint"]
