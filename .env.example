PORT=8080
HOST_PORT=8080
NODE_ENV=development

# Cambia a false cuando el equipo Hikvision este accesible desde la maquina.
MOCK_DEVICE=true

HIKVISION_HOST=192.168.1.77
BRIDGE_IDENTIFIER=Nuevo Dispositivo Bridge
LOCAL_DEVICE_ID=
HIKVISION_PORT=80
HIKVISION_PROTOCOL=http
HIKVISION_USERNAME=admin
HIKVISION_PASSWORD=change-me
HIKVISION_DOOR_NO=1
HIKVISION_PLAN_TEMPLATE_NO=1
HIKVISION_FDID=1
HIKVISION_FACE_LIB_TYPE=blackFD
HIKVISION_DEDUP_WINDOW_SECONDS=8

# Integracion opcional con la nube EOLO.
EOLO_API_BASE_URL=
EOLO_API_TOKEN=
EOLO_EVENT_ENDPOINT=/api/device-events
EOLO_TASKS_ENDPOINT=/api/local-agent/tasks
EOLO_TASK_ACK_ENDPOINT=/api/local-agent/tasks
EOLO_POLL_ENABLED=false
EOLO_POLL_INTERVAL_SECONDS=30
EOLO_USER_SYNC_ENABLED=false
EOLO_USER_SYNC_ENDPOINT=https://eolo.app/version-test/api/1.1/wf/permisos-acceso
EOLO_ACCESS=
EOLO_USER_SYNC_INTERVAL_MINUTES=30

# Cliente local de operador de acceso.
# Produccion usa live por default. Para version-test usa EOLO_OPERATOR_VERSION=test.
# Tambien puedes elegir version-test o Custom desde Ajustes.
EOLO_OPERATOR_AUTH_MODE=cloud
EOLO_OPERATOR_APP_BASE_URL=https://eolo.app
EOLO_OPERATOR_VERSION=live
EOLO_OPERATOR_LOGIN_ENDPOINT=apk_login
EOLO_OPERATOR_SMS_LOGIN_ENDPOINT=
EOLO_OPERATOR_ACCESSES_ENDPOINT=bridge_operator_accesses
EOLO_OPERATOR_ACCESSES_METHOD=GET
EOLO_OPERATOR_CONTROL_POINTS_ENDPOINT=bridge_operator_control_points
EOLO_OPERATOR_CONTROL_POINTS_METHOD=GET
EOLO_OPERATOR_MOVEMENTS_ENDPOINT=bridge_operator_movements_today
EOLO_OPERATOR_MOVEMENTS_METHOD=GET
EOLO_OPERATOR_RESIDENTS_ENDPOINT=bridge_operator_residents
EOLO_OPERATOR_RESIDENTS_METHOD=GET
EOLO_OPERATOR_CREATE_MOVEMENT_ENDPOINT=bridge_operator_create_movement
EOLO_OPERATOR_CREATE_MOVEMENT_METHOD=POST
EOLO_OPERATOR_EGRESS_MOVEMENT_ENDPOINT=bridge_operator_egress_movement
EOLO_OPERATOR_EGRESS_MOVEMENT_METHOD=POST
EOLO_OPERATOR_FILE_UPLOAD_ENDPOINT=fileupload
EOLO_OPERATOR_ATTACH_IDENTIFICATION_ENDPOINT=bridge_operator_attach_identification_photo
EOLO_OPERATOR_ATTACH_IDENTIFICATION_METHOD=POST
EOLO_OPERATOR_CLOUD_STATUS_ENDPOINT=bridge_operator_ping
EOLO_OPERATOR_CLOUD_STATUS_METHOD=GET
EOLO_OPERATOR_DEVICE_HEARTBEAT_ENABLED=true
EOLO_OPERATOR_DEVICE_HEARTBEAT_ENDPOINT=bridge_operator_device_heartbeat
EOLO_OPERATOR_DEVICE_HEARTBEAT_METHOD=POST
EOLO_OPERATOR_DEVICE_DATA_TYPE=dispositivosacceso
# Opcional. Si se deja vacio, se usa LOCAL_DEVICE_ID o se genera un ID persistente en DATA_DIR/bridge-device-id.
EOLO_OPERATOR_DEVICE_ID=
EOLO_OPERATOR_SYNC_INTERVAL_MINUTES=5
EOLO_OPERATOR_COMPANY=TRACSA
EOLO_OPERATOR_ACCESS_NAME=Caseta Periferico

# OpenAI Vision para leer nombre desde fotografia de identificacion.
OPENAI_VISION_ENABLED=false
OPENAI_VISION_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_VISION_TIMEOUT_SECONDS=18

# API interna de AnprEolo; Bridge la usa para controlar ANPR/visitas.
ANPR_API_BASE_URL=http://127.0.0.1:8090
ANPR_STREAM_HOST_PORT=8083
ANPR_STREAM_PUBLIC_URL=http://localhost:8083
ANPR_WEBRTC_ENABLED=true
ANPR_WEBRTC_AUTOSTART=false
ANPR_WEBRTC_API_URL=http://127.0.0.1:1984
ANPR_WEBRTC_HOST_PORT=1984
ANPR_WEBRTC_PUBLIC_URL=http://localhost:1984
ANPR_WEBRTC_PORT=8555
# En otra PC de la LAN usa la IP del equipo Docker, por ejemplo 192.168.1.50.
ANPR_WEBRTC_ICE_HOST=
GO2RTC_BINARY=/usr/local/bin/go2rtc
GO2RTC_CONFIG_FILE=/app/data/go2rtc.yaml
ANPR_SNAPSHOT_DIR=/app/data/anpr-snapshots

DATA_DIR=./data
UPLOAD_DIR=./uploads
